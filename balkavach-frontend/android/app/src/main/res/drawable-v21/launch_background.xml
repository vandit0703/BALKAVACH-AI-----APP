<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash (before Android 12): BALKAVACH logo centred, 220dp.
     Night mode picks drawable-night-*/launch_logo.png automatically.
     Android 12+ shows the system splash with the adaptive launcher icon instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
