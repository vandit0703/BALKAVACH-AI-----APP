# Copy to .env and fill in. Never commit real values.
APP_NAME=BalKavach API
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# A DISPOSABLE database whose name contains "test"; the integration tests refuse
# to run against DATABASE_URL. Apply `alembic upgrade head` to it first.
TEST_DATABASE_URL=
# Alembic refuses to run unless this is true. Turn it on only for a reviewed
# migration run, then off again (see docs/backend-operations.md).
ALLOW_SCHEMA_MIGRATIONS=false

# --- authentication ---------------------------------------------------------
# At least 32 random bytes, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Generate a separate Fernet key with `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`.
CHILD_CREDENTIALS_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CHILD_REFRESH_TOKEN_EXPIRE_DAYS=14

# --- browsers ----------------------------------------------------------------
# JSON array of exact origins that may call the API from a browser (the admin
# panel). The mobile app does not need CORS.
CORS_ORIGINS=["http://localhost:3000"]

# --- push notifications (optional; see docs/push-notifications-setup.md) ----------
# Leave empty to run with in-app notifications only.
NOTIFICATION_PROVIDER=
#NOTIFICATION_PROVIDER=app.integrations.fcm:create_provider
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=

# --- mission photo storage ----------------------------------------------------------
# "local" writes under UPLOAD_DIR: development only, files vanish on an
# ephemeral host. Production should use "s3" (any S3-compatible service) and
# `pip install -r requirements-storage-s3.txt`.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5000000
MAX_UNATTACHED_UPLOADS=10
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- hosted video playback (existing feature) ------------------------------------------
VIDEO_PLAYBACK_PROVIDER=

# --- YouTube discovery (backend only; never put this key in a Flutter app) ---------------
# Restrict the key in Google Cloud to the YouTube Data API v3 (and to server IPs).
# Unset: discovery/approval/recheck return 503 youtube_not_configured; the child feed
# keeps working and shows only already-approved, recently verified videos.
YOUTUBE_API_KEY=
# Optional ISO 3166-1 alpha-2 code; videos blocked in this region are marked unavailable.
YOUTUBE_REGION_CODE=
# Approved videos drop out of the child feed if not re-verified within this many hours.
YOUTUBE_REVERIFY_HOURS=72
